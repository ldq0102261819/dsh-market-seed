{
  "name": "dsh-market-seed",
  "version": "0.1.1",
  "description": "Seed DSH plugin-market index sources on startup, so installing this bundle is enough to browse and install community plugins from the Discover tab.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-market"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ldq0102261819/dsh-market-seed.git"
  },
  "homepage": "https://github.com/ldq0102261819/dsh-market-seed#readme",
  "bugs": {
    "url": "https://github.com/ldq0102261819/dsh-market-seed/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
